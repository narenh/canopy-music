// Copy this file to Config/Secrets.xcconfig (gitignored, never committed) and fill it in.
// Debug builds only: Config/Debug.xcconfig includes it, and Release builds never see it.
//
// CMDLP_DEV_TOKEN: a hub token from the direct audio server's admin page
// (https://cmdlp.canopysf.com/admin), used by dev builds when Settings › Advanced has no
// Access Token. No quotes. In an xcconfig "//" starts a comment, so a value containing it
// would be cut short (cmdlp's tokens don't contain it).

CMDLP_DEV_TOKEN =
