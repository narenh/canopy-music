<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Run as the TV's current user, the one Apple Music plays for. Without it the app runs as a
	     generic user, can't open the player's library, and the player connection keeps dropping. -->
	<key>com.apple.developer.user-management</key>
	<array>
		<string>runs-as-current-user</string>
	</array>
</dict>
</plist>
